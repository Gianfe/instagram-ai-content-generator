INSTAGRAM_APP_ID=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Cloudinary credentials and optional destination folder.
# Set either CLOUDINARY_URL (as shown in the Cloudinary dashboard)...
CLOUDINARY_URL=
# ...or the three separate variables below.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Optional: force the Graph API host. Auto-detected from the access token prefix
# otherwise (IGAA... -> graph.instagram.com, EAA... -> graph.facebook.com).
# INSTAGRAM_API_HOST=
